{
  "name": "jsf-labs",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Шаблон репозиторію лабораторних робіт дисципліни JavaScript Frameworks",
  "workspaces": ["react-ts", "svelte-5"],
  "scripts": {
    "build": "node tools/workspaces.mjs build",
    "typecheck": "node tools/workspaces.mjs typecheck",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node tools/workspaces.mjs test",
    "test:root": "vitest run",
    "data": "node generator/index.mjs",
    "size": "node tools/size.mjs",
    "journal": "node tools/journal.mjs",
    "diff": "node tools/diff.mjs",
    "route": "node tools/route.mjs",
    "find": "node tools/find.mjs",
    "lifecycle": "node tools/lifecycle-scripts.mjs",
    "tree": "node tools/tree.mjs",
    "sbom": "node tools/sbom.mjs",
    "attribution": "node tools/attribution.mjs",
    "lockfile": "node tools/lockfile.mjs",
    "ready": "node tools/ready.mjs",
    "check": "node tools/check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.3",
    "vitest": "5.0.0"
  }
}
